{
  "name": "article-topics/freshrss-extension",
  "description": "Static analysis tooling for the FreshRSS Article Topics extension",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "lint": "php scripts/lint.php",
    "test": "php tests/run.php",
    "stan": "php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
    "stan-contract": "php vendor/bin/phpstan analyse -c phpstan-contract.neon --no-progress --memory-limit=512M",
    "check": ["@lint", "@test", "@stan", "@stan-contract"]
  }
}
